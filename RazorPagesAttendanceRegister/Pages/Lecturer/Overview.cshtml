@page
@model RazorPagesAttendanceRegister.Pages.Lecturer.OverviewModel
@{
    ViewData["Title"] = "Attendance Overview";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-uppercase text-primary fw-semibold mb-1">Lecturer portal</p>
            <h1 class="mb-1">Attendance overview</h1>
            <p class="text-muted mb-0">Compare attendance patterns across lecture dates.</p>
        </div>
        <a asp-page="/Lecturer/ViewAttendance" class="btn btn-outline-secondary">Back to courses</a>
    </div>

    @if (Model.Courses.Any())
    {
        <form method="get" class="mb-4">
            <label for="courseId" class="form-label">Course</label>
            <select id="courseId" name="courseId" class="form-select" onchange="this.form.submit()">
                @foreach (var course in Model.Courses)
                {
                    <option value="@course.Id" selected="@(course.Id == Model.CourseId)">
                        @course.Code - @course.Name
                    </option>
                }
            </select>
        </form>

        @if (Model.AttendanceOverview.Any())
        {
            <section class="card">
                <div class="card-body">
                    <div class="attendance-chart-container">
                        <canvas id="attendanceOverviewChart" data-chart="@Model.ChartDataJson"
                                aria-label="Attendance overview chart"></canvas>
                    </div>
                </div>
            </section>
        }
        else
        {
            <p class="text-muted">No attendance data available for this course yet.</p>
        }
    }
    else
    {
        <p class="text-muted">No attendance data available for this course yet.</p>
    }
</div>

@if (Model.AttendanceOverview.Any())
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="~/js/overview.js" asp-append-version="true"></script>
    }
}
