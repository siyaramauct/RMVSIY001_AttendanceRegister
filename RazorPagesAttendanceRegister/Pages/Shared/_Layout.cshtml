<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UCT Attendance Register</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Serif+Ottoman+Siyaq&display=swap"
    rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorPagesAttendanceRegister.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="page-shell">
        <header class="topbar">
            <nav class="navbar">
                <div class="container nav-wrap">
                    <a class="navbar-brand brand" asp-area="" asp-page="/Index"
                       aria-label="UCT Attendance Register home">
                        <span class="brand-mark">
                            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQYj4B9_fQ3xIZOhhJM4Xokl-bUg45bA3GPm7VJE2dxgfHpIBWWs2N6IiQV&s=10"
                                 alt="University of Cape Town logo" />
                        </span>
                        <span class="brand-copy">
                            <span class="brand-title">Attendance Register</span>
                            <span class="brand-subtitle">University of Cape Town</span>
                        </span>
                    </a>

                    <div class="nav-center" aria-label="Primary navigation">
                        <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        <a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a>
                    </div>

                    <div class="nav-actions">
                        @await Html.PartialAsync("_LoginPartial")
                    </div>
                </div>
            </nav>
        </header>

        <main class="container layout-main">
            @RenderBody()
        </main>

        <footer class="footer-shell">
            <div class="container footer-inner">
                <span>© 2026 UCT Attendance Register</span>
                <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
