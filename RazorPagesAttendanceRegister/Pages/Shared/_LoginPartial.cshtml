@using Microsoft.AspNetCore.Identity
@using RazorPagesAttendanceRegister.Models

@inject SignInManager<AttendanceUser> SignInManager
@inject UserManager<AttendanceUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser is null
        ? "User"
        : !string.IsNullOrWhiteSpace(currentUser.Name)
            ? currentUser.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault()
?? currentUser.Name
            : !string.IsNullOrWhiteSpace(currentUser.Email)
                ? currentUser.Email.Split('@')[0]
                : currentUser.UserName ?? "User";
}

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Student"))
        {
            <li class="nav-item">
                <a class="nav-link" asp-page="/Student/RecordAttendance">Record Attendance</a>
            </li>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <li class="nav-item">
                <a class="nav-link" asp-page="/Lecturer/ViewAttendance">Manage Attendance</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-page="/Lecturer/ManageQueries">Manage Queries</a>
            </li>
        }
        <li class="nav-item">
            <span class="nav-user-name" aria-label="Signed in user">Hello @displayName!</span>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                <button id="logout" type="submit" class="nav-link btn btn-link border-0">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>
